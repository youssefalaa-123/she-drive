# Files excluded from the EAS Build archive.
# EAS uploads ALL files (including untracked) unless excluded here.

# ── Secrets (never send to EAS servers) ──────────────────────────────────────
google-play-service-account.json
.env
.env.*
*.pem
*.key

# ── AI tool caches (ruflo, graphify, claude, impeccable) ─────────────────────
.swarm/
graphify-out/
ruvector.db
.impeccable/
.claude/
.claude-flow/
.mcp.json
.graphifyignore

# ── Expo local dev cache ──────────────────────────────────────────────────────
.expo/

# ── Web build output (EAS reads metadata.json; dist/ one confuses it) ────────
dist/

# ── Server-side / Supabase ────────────────────────────────────────────────────
supabase/
functions/

# ── Admin web dashboard ───────────────────────────────────────────────────────
/admin/

# ── Test tooling ──────────────────────────────────────────────────────────────
tests/
test-results/
playwright.config.js

# ── Docs and misc ─────────────────────────────────────────────────────────────
ARCHITECTURE.md
AGENTS.md
LICENSE
README.md
skills-lock.json
nul

# ── EAS / git meta ────────────────────────────────────────────────────────────
eas.json
CLAUDE.md
